{
  "expo": {
    "name": "Task Running",
    "slug": "task-running",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icone-tr.png",
    "scheme": "taskrunning",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/icone-tr-foreground.png",
        "monochromeImage": "./assets/images/icone-tr-monocromatico.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.uniube.taskrunning",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0F172A"
  }
}
