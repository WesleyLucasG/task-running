# Copie para .env.local (não versionado) e ajuste o endereço da API.
# Sem esta variável o app roda em "modo local" (dados só no aparelho).
#
# Desenvolvimento (backend no seu PC, celular na mesma rede Wi-Fi):
#   EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL:8080
# Produção (nuvem, HTTPS obrigatório - RNF22):
#   EXPO_PUBLIC_API_URL=https://sua-api.exemplo.com
EXPO_PUBLIC_API_URL=
